# Salin berkas ini jadi .env lalu isi nilainya.
# Semua variabel di sini benar-benar dibaca kode. Yang bertanda (opsional)
# boleh dikosongkan — akibatnya dijelaskan di keterangan masing-masing.
#
# Ingat: isi berkas ini ikut terbawa ke dalam berkas hasil build dan bisa
# dibaca siapa pun yang membuka situs. Jangan menaruh kunci rahasia di sini.

# =========================
# SAMBUNGAN KE BACKEND
# =========================
# Alamat backend beserta akhiran /api.
# Saat mengembangkan di komputer: http://localhost:5000/api
VITE_API_BASE_URL="https://nama-api.onrender.com/api"

# =========================
# SEO
# =========================
# (opsional) Alamat situs, tanpa garis miring di akhir,
# mis. https://talitascake.com
#
# Kalau dikosongkan, penunjuk alamat resmi halaman dan pratinjau tautan tidak
# dipasang. Itu disengaja: alamat yang salah lebih berbahaya daripada tidak
# ada, karena bisa membuat mesin pencari menganggap situs ini salinan situs
# lain. Wajib diisi saat dideploy.
VITE_SITE_URL=""

# =========================
# PETA CHECKOUT
# =========================
# (opsional) Kunci MapTiler, gratis di https://cloud.maptiler.com
# Kalau dikosongkan, peta tetap tampil memakai tampilan tanpa kunci, dan
# pencarian alamat memakai layanan cadangan yang juga tanpa kunci.
VITE_MAPTILER_KEY=""

# =========================
# IDENTITAS TOKO
# =========================
# Semuanya opsional. Yang dikosongkan otomatis tidak ditampilkan — misalnya
# kalau TikTok tidak diisi, ikonnya tidak muncul di footer.

# Format internasional TANPA tanda "+"
VITE_OWNER_WHATSAPP_NUMBER=""

# Ketiganya nama pengguna TANPA tanda "@"
VITE_OWNER_INSTAGRAM=""
VITE_OWNER_THREADS=""
VITE_OWNER_TIKTOK=""

VITE_STORE_ADDRESS=""

# (opsional) Nomor sertifikat halal BPJPH. Sudah ada nilai bawaannya di kode,
# jadi hanya perlu diisi kalau nomornya berubah.
VITE_HALAL_CERT_NUMBER=""
