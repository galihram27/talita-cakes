# Salin berkas ini jadi .env lalu isi nilainya.
# Semua variabel di sini benar-benar dibaca kode. Yang bertanda (opsional)
# boleh dikosongkan — akibatnya dijelaskan di keterangan masing-masing.

# =========================
# BASIS DATA
# =========================
# PostgreSQL. Kalau memakai Neon, pilih connection string yang POOLED
# (alamatnya mengandung "-pooler").
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# =========================
# APLIKASI
# =========================
# Isi "production" saat dideploy. Kosongkan saat mengembangkan di komputer.
NODE_ENV=production

# (opsional) Default 5000. Di Render terisi otomatis, jadi jangan diisi di sana.
# PORT=5000

# Alamat frontend. Menentukan domain mana yang boleh mengakses API sekaligus
# ke mana cookie sesi boleh dikirim.
FRONTEND_URL="https://nama-app.vercel.app"

# =========================
# LOGIN & TOKEN
# =========================
# Dua kunci ini WAJIB BERBEDA. Kalau sama, refresh token bisa dipakai sebagai
# access token. Isi teks acak yang panjang.
JWT_SECRET="isi-teks-acak-yang-panjang"
JWT_REFRESH_SECRET="isi-teks-acak-lain-yang-berbeda"

# =========================
# AKUN ADMIN PERTAMA
# =========================
# Dipakai perintah `npx prisma db seed` untuk membuat akun admin. Aman
# dijalankan berkali-kali: akun yang sudah ada diperbarui, bukan diduplikasi.
# Kalau keempatnya tidak lengkap, pembuatan admin dilewati begitu saja.
ADMIN_NAME="Nama Admin"
ADMIN_EMAIL="admin@domainmu.com"
ADMIN_PASSWORD="sandi-yang-kuat"
ADMIN_PHONE="6281234567890"

# =========================
# PENYIMPANAN GAMBAR (Cloudinary)
# =========================
# Semua foto produk & galeri disimpan di sini. Server ini tidak menyimpan
# berkas apa pun, karena hosting seperti Render tidak punya disk permanen.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# =========================
# EMAIL (Resend)
# =========================
# Mengirim kode OTP untuk verifikasi email & atur ulang sandi.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Talita Cakes <no-reply@domainmu.com>"

# (opsional) Logo di dalam email. Kalau dikosongkan, dipakai logo.png milik
# frontend. Isi hanya kalau logonya ingin diambil dari tempat lain.
EMAIL_LOGO_URL=""

# =========================
# IDENTITAS & LOKASI TOKO
# =========================
# Nomor tujuan pesanan. Format internasional TANPA tanda "+".
OWNER_WHATSAPP_NUMBER="6281234567890"

# Titik lokasi toko, jadi acuan perhitungan ongkir.
STORE_LATITUDE=""
STORE_LONGITUDE=""

# =========================
# JARAK & ONGKIR
# =========================
# (opsional) HERE Routing API, untuk menghitung jarak rute motor.
# Kalau dikosongkan, jarak dihitung garis lurus — hasilnya lebih pendek
# daripada jarak jalan sebenarnya, sehingga ongkir bisa lebih murah dari
# yang seharusnya.
HERE_API_KEY=""

# =========================
# ULASAN GOOGLE
# =========================
# (opsional) Untuk mengambil rating & ulasan Google Maps toko.
# CATATAN: endpoint-nya sudah jadi tapi belum dipakai frontend — halaman
# ulasan saat ini memakai teks yang ditulis langsung di dalam kodenya.
GOOGLE_MAPS_API_KEY=""
GOOGLE_PLACE_ID=""

# =========================
# PENCATATAN PENGUNJUNG
# =========================
# (opsional) Pengacak penanda pengunjung cadangan, terpakai hanya kalau
# peramban memblokir penyimpanan. Sudah punya nilai bawaan; isi kalau ingin
# penandanya tidak bisa ditebak dari pemasangan lain.
VISITOR_ID_SALT=""

# =========================
# BUILD ULANG OTOMATIS
# =========================
# (opsional) Halaman publik dibangun jadi HTML saat build, jadi konten baru
# baru terbaca mesin pencari setelah build ulang. Isi dengan Deploy Hook dari
# hosting frontend, maka backend memicunya sendiri tiap produk/galeri berubah.
# Kosong = fitur mati (aman untuk pengembangan lokal).
DEPLOY_HOOK_URL=""

# (opsional) Jeda pemicu dalam milidetik, default 120000 (2 menit). Banyak
# perubahan beruntun hanya menghasilkan satu build.
DEPLOY_HOOK_DEBOUNCE_MS=""

# =========================
# ASISTEN BELANJA (Google Gemini)
# =========================
# (opsional) Kunci dari https://aistudio.google.com. Kalau dikosongkan, situs
# tetap berjalan normal, hanya endpoint /api/chat yang membalas 503.
# Pakai kunci terpisah dari kunci latihan, supaya bisa dicabut sendiri-sendiri.
GEMINI_API_KEY=""

# Nama model kelas Flash. Nama model Gemini sering berganti dan model lama
# bisa ditutup untuk pengguna baru, jadi ambil dari daftar di AI Studio.
GEMINI_MODEL=""
